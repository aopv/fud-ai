    "Before Fud AI sends data to a third-party AI provider, we need your permission." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل أن يرسل Fud AI البيانات إلى مزوّد ذكاء اصطناعي خارجي، نحتاج إلى إذنك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fud AI üçüncü tərəf AI provayderinə məlumat göndərməzdən əvvəl icazəniz lazımdır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor Fud AI Daten an einen externen KI-Anbieter sendet, benötigen wir deine Zustimmung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de que Fud AI envíe datos a un proveedor de IA externo, necesitamos tu permiso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant que Fud AI n'envoie des données à un fournisseur d'IA tiers, nous avons besoin de votre autorisation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fud AI द्वारा किसी तृतीय-पक्ष AI प्रदाता को डेटा भेजने से पहले, हमें आपकी अनुमति चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima che Fud AI invii dati a un fornitore di IA di terze parti, abbiamo bisogno del tuo permesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fud AIがサードパーティのAIプロバイダーにデータを送信する前に、許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fud AI가 타사 AI 제공업체로 데이터를 보내기 전에 사용자의 동의가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voordat Fud AI gegevens naar een externe AI-provider stuurt, hebben we je toestemming nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de o Fud AI enviar dados para um provedor de IA de terceiros, precisamos da sua permissão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înainte ca Fud AI să trimită date către un furnizor de IA terț, avem nevoie de permisiunea ta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежде чем Fud AI отправит данные стороннему провайдеру ИИ, нам нужно ваше разрешение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
