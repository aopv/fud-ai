{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fud-ai.app" }],
      "destination": "https://www.fud-ai.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    { "source": "/add-meal", "destination": "/add-meal.html" }
  ]
}
